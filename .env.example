# Nothing is required here — real per-person login (owner setup + invite-based member
# registration) is configured in the app itself, not via an env var. Every variable below is
# optional.

# Optional — comma-separated CORS allow-list. Leave unset to allow any origin (see
# docs/reference/environment-variables.md for why that's low-risk here — auth is a session bearer
# token in a header, not a cookie).
# LIFTR_ALLOWED_ORIGINS=https://liftr.example.com

# Optional — enables road-snapped distance/elevation for planned routes via OpenRouteService.
# Leave unset for straight-line distance only (fully supported, not a misconfiguration).
# LIFTR_ORS_API_KEY=
# LIFTR_ORS_BASE_URL=https://api.openrouteservice.org

# Optional — port the container publishes on the host. The container-internal port is fixed at
# 3001 regardless of this value (docker-compose.yml pins PORT=3001 inside the container) — do
# NOT set a plain `PORT` here, it would change the app's own listen port inside the container
# without changing the healthcheck or the container side of the port mapping, breaking both.
# LIFTR_HOST_PORT=3001
