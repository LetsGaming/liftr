{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "jsx": "preserve",
    "types": ["vite/client"],
    "declaration": false,
    "declarationMap": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@liftr/shared": ["packages/shared/src/index.ts"],
      "@liftr/shared/*": ["packages/shared/src/*"],
      "@liftr/db": ["packages/db/src/index.ts"],
      "@liftr/db/*": ["packages/db/src/*"],
      "~client/*": ["packages/client/src/*"]
    }
  },
  "include": ["src"]
}
