{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "noEmit": true,
    "outDir": "dist-test-typecheck-unused",
    "paths": {
      "@liftr/shared": ["packages/shared/src/index.ts"],
      "@liftr/shared/*": ["packages/shared/src/*"],
      "@liftr/db": ["packages/db/src/index.ts"],
      "@liftr/db/*": ["packages/db/src/*"],
      "~ingest/*": ["packages/ingest/src/*"]
    }
  },
  "include": ["src", "../../tests/ingest"]
}
