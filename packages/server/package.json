{
  "name": "@liftr/server",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch --conditions=development src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "recompute": "tsx --conditions=development src/recompute.ts",
    "reset-password": "tsx --conditions=development src/resetPassword.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "@garmin/fitsdk": "^21.214.0",
    "@liftr/db": "workspace:*",
    "@liftr/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^4.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
