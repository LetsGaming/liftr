{
  "name": "liftr",
  "private": true,
  "version": "1.5.3",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm bootstrap && concurrently -n server,client -c blue,green \"pnpm --filter @liftr/server dev\" \"pnpm --filter @liftr/client dev\"",
    "build": "pnpm -r --filter=./packages/* build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "pnpm -r --filter=./packages/* run typecheck && pnpm typecheck:tests",
    "typecheck:tests": "tsc --noEmit -p packages/shared/tsconfig.test.json && tsc --noEmit -p packages/db/tsconfig.test.json && tsc --noEmit -p packages/ingest/tsconfig.test.json && tsc --noEmit -p packages/server/tsconfig.test.json && pnpm --filter @liftr/client exec vue-tsc --noEmit -p tsconfig.test.json",
    "db:generate": "pnpm --filter @liftr/db generate",
    "db:migrate": "pnpm --filter @liftr/db migrate",
    "icons:gen": "node scripts/gen-icons.mjs",
    "ingest": "pnpm --filter @liftr/ingest start",
    "bootstrap": "pnpm --filter @liftr/ingest bootstrap",
    "recompute": "pnpm --filter @liftr/server recompute",
    "reset-password": "pnpm --filter @liftr/server reset-password"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@liftr/db": "workspace:*",
    "@liftr/shared": "workspace:*",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^10.0.5",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "fastify": "^5.12.5",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "leaflet": "^1.9.4",
    "pinia": "^4.0.3",
    "prettier": "^3.9.8",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
