{
  "name": "liftr",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "1.8.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm bootstrap && concurrently -n server,client -c blue,green \"pnpm --filter @liftr/server dev\" \"pnpm --filter @liftr/client dev\"",
    "build": "pnpm -r --filter=./packages/* build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "pnpm -r --filter=./packages/* run typecheck && pnpm typecheck:tests",
    "typecheck:tests": "tsc --noEmit -p packages/shared/tsconfig.test.json && tsc --noEmit -p packages/db/tsconfig.test.json && tsc --noEmit -p packages/ingest/tsconfig.test.json && tsc --noEmit -p packages/server/tsconfig.test.json && pnpm --filter @liftr/client exec vue-tsc --noEmit -p tsconfig.test.json",
    "db:generate": "pnpm --filter @liftr/db generate",
    "db:migrate": "pnpm --filter @liftr/db migrate",
    "icons:gen": "node scripts/gen-icons.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "ingest": "pnpm --filter @liftr/ingest start",
    "bootstrap": "pnpm --filter @liftr/ingest bootstrap",
    "recompute": "pnpm --filter @liftr/server recompute",
    "reset-password": "pnpm --filter @liftr/server reset-password"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@liftr/db": "workspace:*",
    "@liftr/shared": "workspace:*",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.1",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^10.0.5",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "fastify": "^5.12.5",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "leaflet": "^1.9.4",
    "pinia": "^4.0.3",
    "prettier": "^3.9.8",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.6.0"
}
